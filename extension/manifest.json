{
  "manifest_version": 3,
  "name": "Still — Manual Scroll for ChatGPT",
  "version": "0.1.2",
  "description": "Read at your own pace. Stops ChatGPT's automatic conversation scrolling while keeping manual scrolling and its bottom button.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "still-chatgpt@emilioferrucci",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "action": {
    "default_title": "Still — Manual Scroll for ChatGPT",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["guard.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["settings.js"],
      "run_at": "document_start"
    }
  ]
}
